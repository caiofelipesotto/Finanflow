# OPENAI_API_KEY: Provedor PRINCIPAL da IA de scan de faturas.
# API Freebuff (compatível com OpenAI) — crie/funde sua chave em
# https://freebuff.com/account/api. No deploy, use Secrets (nunca .env público).
OPENAI_API_KEY="MY_OPENAI_KEY"

# GEMINI_API_KEY: Fallback opcional (Google AI Studio), usado apenas
# se OPENAI_API_KEY não estiver configurada.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o app está hospedado (links e callbacks).
APP_URL="MY_APP_URL"
