# ============================================================
# IA do scan de faturas (/api/scan-invoice)
# Ordem de uso no servidor:
#   1. Provedor OpenAI-compatível  -> OPENAI_API_KEY
#   2. Gemini (Google AI Studio)   -> GEMINI_API_KEY
#   3. Sem chave nenhuma           -> modo simulação
# ============================================================

# --- Opção 1 (padrão): API Freebuff (compatível com OpenAI) ---
# Crie/funde sua chave em https://freebuff.com/account/api
OPENAI_API_KEY="MY_OPENAI_KEY"

# --- Opção 2: Gemini (Google AI Studio) ---
# Chave gratuita em https://aistudio.google.com/apikey
# Usada só se OPENAI_API_KEY não existir.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Qualquer outro provedor OpenAI-compatível (opcional) ---
# Basta apontar a base URL e o modelo; a chave continua na OPENAI_API_KEY.
# Exemplos:
#   OpenAI direto:      OPENAI_BASE_URL="https://api.openai.com/v1"
#   Groq:               OPENAI_BASE_URL="https://api.groq.com/openai/v1"
#   OpenRouter:         OPENAI_BASE_URL="https://openrouter.ai/api/v1"
#   Gemini (via OpenAI-compatível):
#                       OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#                       OPENAI_API_KEY="sua chave do Google AI Studio"
#   OPENAI_MODEL: nome do modelo de visão do provedor (padrão: gpt-4o-mini)
# OPENAI_BASE_URL=""
# OPENAI_MODEL=""

# APP_URL: URL onde o app está hospedado (links e callbacks).
APP_URL="MY_APP_URL"
